{
  "name": "root",
  "license": "UNLICENSED",
  "scripts": {
    "update": "yarn upgrade-interactive",
    "format": "prettier --write \"**/src/**/*.{ts,tsx}\" \"**/test/**/*.ts\" \"**/prisma/**/*.ts\"",
    "lint": "eslint clients layouts library/domain modules pages",
    "dev:desktop_ui": "yarn workspace @client/desktop dev",
    "dev:storybook": "yarn workspace @client/storybook start",
    "start:storybook": "yarn workspace @client/storybook start",
    "build:desktop_ui": "yarn workspace @client/desktop build",
    "build:storybook": "yarn workspaces foreach -tR --from '@client/storybook' -R run build",
    "test:storefront": "node --import ./library/sellgar.app.ui/next/module/runtime/module-session/register-test-loader.mjs --test 'library/domain/**/*.test.ts' 'modules/**/*.test.ts' 'pages/home/**/*.test.ts'",
    "typecheck": "yarn workspace @client/desktop typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "workspaces": [
    "clients/**/*",
    "helpers/*",
    "library/*",
    "pages/**/*",
    "utils/**/*",
    "widgets/**/*",
    "layouts/**/*",
    "modules/**/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.0"
}
